{
  "name": "carnage-reporter-client",
  "version": "1.7.0",
  "description": "Cliente ligero para CarnageReporter - Halo 3 MCC",
  "main": "carnage_client.js",
  "scripts": {
    "start": "node carnage_client.js",
    "test": "node --test test/*.test.js",
    "build": "pkg carnage_client.js --targets node22-win-x64 --output dist/CarnageReporter.exe"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "fast-xml-parser": "^4.3.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist",
    "assets": [
      "test/fixtures/mpcarnagereport_2v2.xml"
    ]
  }
}
