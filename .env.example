# ============================================================
# CarnageReporter - Variables de entorno (servidor)
# Copia este archivo a .env y llena los valores reales.
# NUNCA subas el .env a git.
# ============================================================

# ----- Servidor -----
PORT=3000
# Key que los clientes mandan en el header X-API-Key (elige una cadena aleatoria larga)
API_KEY=
# Key de administración para endpoints /api/admin/* (distinta a API_KEY)
ADMIN_KEY=
# Nivel de log (Fase A1, server/logger.js): trace|debug|info|warn|error|fatal.
# 'info' es lo normal en producción; 'debug' para diagnosticar algo puntual.
LOG_LEVEL=info
# El dashboard se sirve desde el MISMO origen del servidor, así que por
# default no hace falta CORS (sin configurar, se desactivan los headers de
# CORS por completo). Solo llena esto si vas a servir el dashboard desde OTRO
# dominio/puerto (ej. desarrollo con Vite en :5173); admite varios separados
# por coma: https://dashboard.midominio.com,http://localhost:5173
CORS_ORIGIN=

# ----- Supabase (Project Settings > API) -----
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=

# ----- Discord -----
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Webhook adicional exclusivo para resultados 4v4 (canal de validación)
DISCORD_WEBHOOK_URL_4V4=https://discord.com/api/webhooks/...
# Webhook de ALERTAS operativas (Fase A1, server/alerts.js): cron caído,
# reporte que falló tras guardarse en Supabase, health check en 'down',
# sesión de WhatsApp perdida/recuperada, errores no atrapados. Si no lo
# configuras, las alertas caen a DISCORD_WEBHOOK_URL (mismo canal que los
# resultados 2v2); se recomienda un canal aparte para no ahogar los avisos
# operativos entre las partidas reportadas.
DISCORD_ALERT_WEBHOOK_URL=

# ----- Stripe (opcional, donaciones) -----
STRIPE_SECRET_KEY=

# ----- WhatsApp (opcional) -----
WHATSAPP_ENABLED=false
# Grupo de 2v2 (Retas H3) — ID o nombre
WHATSAPP_GROUP_ID=
WHATSAPP_GROUP_NAME=
# Grupo de 4v4 (Torneos Halo 3) — ID o nombre
WHATSAPP_GROUP_ID_4V4=
WHATSAPP_GROUP_NAME_4V4=
# Directorio de sesión persistente (default: server/.wwebjs_auth)
# WHATSAPP_AUTH_DIR=
# Admins del bot además del propio teléfono (JIDs separados por coma,
# ej. 5215512345678@c.us). Pueden usar !vincula y !roster unlink.
WHATSAPP_ADMIN_JIDS=
# Alias nuevo de WHATSAPP_ADMIN_JIDS (Fase A3, mismo formato). Si defines
# los dos, se toman en cuenta ambos (unión).
WHATSAPP_ADMIN_IDS=
# Si es "true", además de WHATSAPP_ADMIN_JIDS/WHATSAPP_ADMIN_IDS también
# cuentan como admin los admins del grupo de WhatsApp de origen (según la
# propia app). Se cachea 10 min por formato.
WHATSAPP_ADMINS_FROM_GROUP=false
# Transporte de mensajería (Fase A3, server/messaging/index.js):
#   wwebjs  -> whatsapp-web.js (default, el único real hoy)
#   fake    -> puerto en memoria, solo para tests/desarrollo sin WhatsApp real
#   baileys -> todavía no implementado (Fase A5)
WHATSAPP_TRANSPORT=wwebjs
# Corre un SEGUNDO transporte en paralelo, en modo solo-lectura (nunca manda
# nada de verdad), para probar un transporte nuevo contra tráfico real sin
# riesgo. Hoy solo se acepta "fake"; vacío = sin shadow.
WHATSAPP_SHADOW_TRANSPORT=
# Ventana de vigencia (segundos) de un comando entrante: un mensaje más
# viejo que esto se ignora sin correr el handler — evita que el historial
# reproducido tras una reconexión dispare un "!rondas reset" viejo.
COMMAND_MAX_AGE_S=120

# ----- Reglas de negocio -----
# Partidas más cortas que esto (segundos) se marcan como anuladas (clientes v2+)
VOID_MIN_DURATION_SECONDS=150
# ...salvo que un equipo haya llegado a este puntaje (2v2): partida real aunque corta
WIN_SCORE_2V2=25
# Mínimo de partidas para competir por tier en el leaderboard
LEADERBOARD_MIN_GAMES=5
# Sesión (!rondas): huecos menores a esto (minutos) = misma noche de retas
SESSION_GAP_MINUTES=150
# Valor de cada ronda ganada (pesos MXN) para la cuenta de la noche
RONDA_MXN=25

# ----- Cliente: identidad de instalación y versión mínima (Fase B3) -----
# Lista de X-Install-Id (UUIDs, uno por instalación del cliente Windows,
# ver client/src/settings.js) a los que se les corta el reporte con
# 403 {status:'revoked'} sin tocar la API_KEY compartida por el resto.
# Separados por coma; vacío = nadie revocado.
REVOKED_INSTALL_IDS=
# Versión mínima de cliente aceptada (semver "x.y.z"). Un reporte con
# clientVersion menor (o sin clientVersion, si esto está configurado) recibe
# 426 {status:'upgrade_required', minVersion}. Vacío = sin mínimo, se acepta
# cualquier versión (compatibilidad con clientes v1/v2 anteriores a esto).
CLIENT_MIN_VERSION=

# ----- Backups (Fase A0) -----
# Por default el backup diario NO empaqueta la sesión de WhatsApp
# (server/.wwebjs_auth): es un perfil de Chromium vivo de 170 MB+ que
# cambia en caliente. Pon esto en true solo si necesitas esa copia local
# (se excluyen cachés de Chromium del tar). Tras la migración a Baileys el
# directorio de sesión pasa a ser credenciales pequeñas y se puede activar
# sin problema.
# BACKUP_INCLUDE_AUTH=false
